# ── docker-compose (n8n) — คัดลอกเป็น .env ที่รากโปรเจกต์ ──
# docker compose อ่าน .env อัตโนมัติ ไม่มีไฟล์นี้ = n8n จะได้ค่าว่างแล้วทุก request โดน 401

N8N_USER=admin
N8N_PASSWORD=<ตั้งเอง>

# ⚠️ หายเมื่อไหร่ credential ทั้งหมดใน n8n อ่านไม่ได้ ต้อง backup
# openssl rand -base64 32
N8N_ENCRYPTION_KEY=<ตั้งเอง>

# dev: ชี้ Next dev server บนเครื่อง (n8n อยู่ใน container จึงต้องใช้ host.docker.internal)
# prod: https://<project>.vercel.app
API_BASE=http://host.docker.internal:3000

# ต้องตรงกับค่าใน apps/web/.env.local เป๊ะ
INTERNAL_HMAC_SECRET=<ค่าเดียวกับ apps/web/.env.local>

# ว่างได้ — ไม่มี token แค่ทำให้ลูกค้าไม่มีชื่อ/รูป ระบบยังทำงานปกติ
LINE_CHANNEL_ACCESS_TOKEN=

# Google Sheets (S8)
GOOGLE_SHEET_ID=<id จาก URL ของ sheet>
# ทั้งไฟล์ service account JSON บีบเป็นบรรทัดเดียว:
#   python3 -c "import json;print(json.dumps(json.load(open('sa.json')),separators=(',',':')))"
GOOGLE_SERVICE_ACCOUNT_JSON=
