{
  "id": "wfh-partner-reconcile",
  "name": "WF-H — Partner Reconcile",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "wfh-partner-reconcile-sch",
      "name": "Schedule (15 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst body = JSON.stringify({});\nconst ts = Math.floor(Date.now()/1000);\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.INTERNAL_HMAC_SECRET).update(`${body}.${ts}`).digest('hex');\nreturn [{ json: { body, headers: { 'content-type':'application/json', 'x-signature':signature, 'x-timestamp':String(ts) } } }];"
      },
      "id": "wfh-partner-reconcile-sign",
      "name": "Sign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE}}/api/internal/partner/reconcile",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "={{$json.headers['content-type']}}"
            },
            {
              "name": "x-signature",
              "value": "={{$json.headers['x-signature']}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.headers['x-timestamp']}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.body}}",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "wfh-partner-reconcile-http",
      "name": "Call endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "Schedule (15 min)": {
      "main": [
        [
          {
            "node": "Sign",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign": {
      "main": [
        [
          {
            "node": "Call endpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "wfe-error-handler"
  }
}