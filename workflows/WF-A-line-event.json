{
  "id": "wfa-line-event",
  "name": "WF-A — LINE Event Processing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 15
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger (dev 15s)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        120
      ],
      "notes": "Production: เปลี่ยนเป็นทุก 1 นาทีได้ เพราะ webhook trigger ก็ล้างคิวเดียวกัน"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "line-event",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        320
      ],
      "webhookId": "line-event"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst payload = { limit: 50, olderThanSec: 0, provider: 'line' };\nconst body = JSON.stringify(payload);\nconst ts = Math.floor(Date.now() / 1000);\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.INTERNAL_HMAC_SECRET).update(`${body}.${ts}`).digest('hex');\nreturn [{ json: { body, headers: { 'content-type': 'application/json', 'x-signature': signature, 'x-timestamp': String(ts) } } }];"
      },
      "id": "sign-claim",
      "name": "Sign Claim Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE}}/api/internal/events/pending",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "={{$json.headers['content-type']}}"
            },
            {
              "name": "x-signature",
              "value": "={{$json.headers['x-signature']}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.headers['x-timestamp']}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.body}}",
        "options": {}
      },
      "id": "claim-events",
      "name": "Claim Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{$json.events.length}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "has-events",
      "name": "Has Events?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        760,
        220
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "events",
        "options": {}
      },
      "id": "split-events",
      "name": "Split Events",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1000,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{$json.needsProfile}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "needs-profile",
      "name": "Needs Profile?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1240,
        120
      ]
    },
    {
      "parameters": {
        "url": "=https://api.line.me/v2/bot/profile/{{$json.lineUserId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.LINE_CHANNEL_ACCESS_TOKEN}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "get-line-profile",
      "name": "Get LINE Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1480,
        20
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// mode: runOnceForEachItem — สำคัญ\n// เดิมเป็น runOnceForAllItems แต่เขียนโดยอ่าน $json (= item แรกเท่านั้น) แล้ว return array ตัวเดียว\n// ผลคือ claim มา 50 event จะเหลือ 49 event ที่ไม่ถูกประมวลผลและค้างเป็น processing ตลอดไป\n// .item ของ n8n จะ resolve paired item ให้ถูกตัวเสมอ แม้ผ่านสาขา IF และ node ที่ error มา\nconst src = $('Split Events').item.json;\nconst p = $json ?? {};\nconst profile = {\n  displayName: typeof p.displayName === 'string' ? p.displayName : null,\n  pictureUrl: typeof p.pictureUrl === 'string' ? p.pictureUrl : null,\n};\nreturn {\n  json: {\n    eventId: src.eventId,\n    payload: {\n      eventId: src.eventId,\n      channelId: src.channelId,\n      lineUserId: src.lineUserId,\n      eventType: src.eventType,\n      occurredAt: src.occurredAt,\n      profile,\n      message: { type: src.messageType ?? null },\n    },\n  },\n};",
        "mode": "runOnceForEachItem"
      },
      "id": "build-payload",
      "name": "Build Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nreturn $input.all().map((item) => {\n  const body = JSON.stringify(item.json.payload);\n  const ts = Math.floor(Date.now() / 1000);\n  const signature = 'sha256=' + crypto.createHmac('sha256', $env.INTERNAL_HMAC_SECRET).update(`${body}.${ts}`).digest('hex');\n  return { json: { eventId: item.json.eventId, body, headers: { 'content-type': 'application/json', 'x-signature': signature, 'x-timestamp': String(ts) } } };\n});"
      },
      "id": "sign-upsert",
      "name": "Sign Upsert Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE}}/api/internal/customers/upsert-from-line",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "={{$json.headers['content-type']}}"
            },
            {
              "name": "x-signature",
              "value": "={{$json.headers['x-signature']}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.headers['x-timestamp']}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.body}}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "upsert-customer",
      "name": "Upsert Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Upsert Customer ตั้ง fullResponse=true → $json เป็น { body, headers, statusCode }\n// ไม่มี eventId อยู่ในนั้น ต้องดึงจาก node ก่อนหน้า (เดิมอ่าน item.json.eventId ได้ undefined\n// แล้วโดน .filter ตัดทิ้งหมด → ack ส่ง results ว่าง → event ค้าง processing วนไม่รู้จบ)\nconst signed = $('Sign Upsert Request').all();\nconst results = $input.all().map((item, i) => {\n  const eventId = signed[i]?.json?.eventId ?? null;\n  const statusCode = Number(item.json?.statusCode ?? 0);\n  const body = item.json?.body ?? {};\n  if (!eventId) return null;\n  if (statusCode >= 200 && statusCode < 300 && body?.ok !== false) {\n    return { eventId, status: 'done', customerId: body?.customerId ?? null };\n  }\n  return { eventId, status: 'failed', error: `upsert ตอบ ${statusCode || 'ไม่ทราบสถานะ'}` };\n}).filter(Boolean);\nreturn [{ json: { payload: { provider: 'line', results } } }];"
      },
      "id": "collect-results",
      "name": "Collect Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2460,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst body = JSON.stringify($json.payload);\nconst ts = Math.floor(Date.now() / 1000);\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.INTERNAL_HMAC_SECRET).update(`${body}.${ts}`).digest('hex');\nreturn [{ json: { body, headers: { 'content-type': 'application/json', 'x-signature': signature, 'x-timestamp': String(ts) } } }];"
      },
      "id": "sign-ack",
      "name": "Sign Ack Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE}}/api/internal/events/ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "={{$json.headers['content-type']}}"
            },
            {
              "name": "x-signature",
              "value": "={{$json.headers['x-signature']}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.headers['x-timestamp']}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.body}}",
        "options": {}
      },
      "id": "ack-events",
      "name": "Ack Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2940,
        120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Schedule Trigger (dev 15s)": {
      "main": [
        [
          {
            "node": "Sign Claim Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Sign Claim Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign Claim Request": {
      "main": [
        [
          {
            "node": "Claim Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Events": {
      "main": [
        [
          {
            "node": "Has Events?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Events?": {
      "main": [
        [
          {
            "node": "Split Events",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Split Events": {
      "main": [
        [
          {
            "node": "Needs Profile?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Profile?": {
      "main": [
        [
          {
            "node": "Get LINE Profile",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get LINE Profile": {
      "main": [
        [
          {
            "node": "Build Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Payload": {
      "main": [
        [
          {
            "node": "Sign Upsert Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign Upsert Request": {
      "main": [
        [
          {
            "node": "Upsert Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upsert Customer": {
      "main": [
        [
          {
            "node": "Collect Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect Results": {
      "main": [
        [
          {
            "node": "Sign Ack Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign Ack Request": {
      "main": [
        [
          {
            "node": "Ack Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "errorWorkflow": "wfe-error-handler"
  },
  "active": false,
  "versionId": "s4-template",
  "meta": {
    "description": "S4 dev workflow: schedule/webhook trigger both drain the queue. No credentials are embedded."
  }
}
