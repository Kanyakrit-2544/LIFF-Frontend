          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "errorWorkflow": "wfe-error-handler"
  },
  "active": false,
  "versionId": "1",
  "meta": {}
}
