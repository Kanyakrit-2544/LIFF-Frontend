{
  "id": "wfc-sheets-sync",
  "name": "WF-C — Google Sheets Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "cron",
      "name": "Schedule (2 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// เซ็น HMAC ให้ตรงกับ body ที่จะส่งจริง — n8n ต้องส่ง body เป็น raw ไม่ให้สร้าง JSON ใหม่\nconst crypto = require('crypto');\nconst payload = { limit: 200 };\nconst body = JSON.stringify(payload);\nconst ts = Math.floor(Date.now() / 1000);\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.INTERNAL_HMAC_SECRET).update(`${body}.${ts}`).digest('hex');\nreturn [{ json: { body, headers: { 'content-type': 'application/json', 'x-signature': signature, 'x-timestamp': String(ts) } } }];"
      },
      "id": "sign-claim",
      "name": "Sign Claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE}}/api/internal/sheets/pending",
        "options": {
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.body}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "={{$json.headers['content-type']}}"
            },
            {
              "name": "x-signature",
              "value": "={{$json.headers['x-signature']}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.headers['x-timestamp']}}"
            }
          ]
        }
      },
      "id": "claim-rows",
      "name": "Claim Rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ ($json.claimed || 0) + (($json.salesReport?.values || []).length) + (($json.intentReport?.values || []).length) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "has-rows",
      "name": "Has Rows?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// สร้าง JWT assertion สำหรับแลก access token ของ Google (service account flow)\nconst crypto = require('crypto');\nconst sa = JSON.parse($env.GOOGLE_SERVICE_ACCOUNT_JSON);\nconst b64 = (s) => Buffer.from(s).toString('base64url');\nconst now = Math.floor(Date.now() / 1000);\nconst header = b64(JSON.stringify({ alg: 'RS256', typ: 'JWT' }));\nconst claim = b64(JSON.stringify({\n  iss: sa.client_email,\n  scope: 'https://www.googleapis.com/auth/spreadsheets',\n  aud: 'https://oauth2.googleapis.com/token',\n  iat: now, exp: now + 3600,\n}));\nconst sig = crypto.sign('RSA-SHA256', Buffer.from(`${header}.${claim}`), sa.private_key).toString('base64url');\nreturn [{ json: { assertion: `${header}.${claim}.${sig}`, rows: $('Claim Rows').first().json.rows, claimed: $('Claim Rows').first().json.claimed } }];"
      },
      "id": "google-token",
      "name": "Google Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grant_type",
              "value": "urn:ietf:params:oauth:grant-type:jwt-bearer"
            },
            {
              "name": "assertion",
              "value": "={{$json.assertion}}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-token",
      "name": "Get Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{$env.GOOGLE_SHEET_ID}}/values/Customers!A2:A",
        "options": {
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": false
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get Token').first().json.access_token }}"
            }
          ]
        }
      },
      "id": "read-keys",
      "name": "Read Keys",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/' + $env.GOOGLE_SHEET_ID + '/values/' + encodeURIComponent($('Claim Rows').first().json.salesReport.tab + '!A:F') + ':clear' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get Token').first().json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "clear-sales-report",
      "name": "Clear Sales Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/' + $env.GOOGLE_SHEET_ID + '/values/' + encodeURIComponent($('Claim Rows').first().json.intentReport.tab + '!A:G') + ':clear' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get Token').first().json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "clear-intent-report",
      "name": "Clear Intent Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// จับคู่ customerId กับเลขแถว แล้วรวม snapshot ฝ่ายขายทั้งสองรายงานไว้ใน batch เดียวกัน\nconst TAB = 'Customers';\nconst claim = $('Claim Rows').first().json;\nconst SYSTEM_COLS = Number(claim.systemColumnCount);\nconst rows = claim.rows || [];\nconst report = claim.salesReport || {};\nconst intent = claim.intentReport || {};\n\nconst letter = (i0) => { let n = i0 + 1, out = ''; while (n > 0) { const r = (n - 1) % 26; out = String.fromCharCode(65 + r) + out; n = Math.floor((n - 1) / 26); } return out; };\nconst lastCol = letter(SYSTEM_COLS - 1);\n\nconst keys = ($('Read Keys').first().json.values || []).map((r) => (r && r[0]) || '');\nconst rowOf = new Map();\nkeys.forEach((k, i) => { if (k) rowOf.set(k, i + 2); });\nlet nextRow = keys.length + 2;\n\nconst data = [];\nconst ids = [];\nfor (const r of rows) {\n  const idx = rowOf.has(r.rowKey) ? rowOf.get(r.rowKey) : nextRow++;\n  data.push({ range: `${TAB}!A${idx}:${lastCol}${idx}`, values: [r.values] });\n  ids.push(r.customerId);\n}\nconst reportRows = Array.isArray(report.values) ? report.values : [];\nif (reportRows.length > 0) {\n  const reportTab = String(report.tab || 'สรุปการขาย').replace(/'/g, \"''\");\n  const reportLastCol = letter(Number(report.columnCount || 6) - 1);\n  data.push({ range: `'${reportTab}'!A1:${reportLastCol}${reportRows.length}`, values: reportRows });\n}\nconst intentRows = Array.isArray(intent.values) ? intent.values : [];\nif (intentRows.length > 0) {\n  const intentTab = String(intent.tab || 'Intent').replace(/'/g, \"''\");\n  const intentLastCol = letter(Number(intent.columnCount || 7) - 1);\n  data.push({ range: `'${intentTab}'!A1:${intentLastCol}${intentRows.length}`, values: intentRows });\n}\nreturn [{ json: { data, ids, count: data.length, hasSalesReport: reportRows.length > 0, hasIntentReport: intentRows.length > 0 } }];"
      },
      "id": "plan-writes",
      "name": "Plan Writes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{$env.GOOGLE_SHEET_ID}}/values:batchUpdate",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ valueInputOption: 'RAW', data: $json.data }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Get Token').first().json.access_token }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "write-rows",
      "name": "Write Rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// batchUpdate สำเร็จทั้งก้อนหรือล้มทั้งก้อน — ไม่มีสถานะรายแถว\nconst upd = $('Write Rows').first().json;\nconst plan = $('Plan Writes').first().json;\nconst ids = plan.ids || [];\nconst okCount = Number(upd?.totalUpdatedRows ?? upd?.responses?.length ?? 0);\nconst ok = okCount > 0 || plan.count === 0;\nif (!ok && ids.length === 0 && plan.hasSalesReport) throw new Error('เขียนแท็บสรุปการขายไม่สำเร็จ');\nconst results = ids.map((customerId) => ({ customerId, status: ok ? 'ok' : 'error', error: ok ? undefined : 'batchUpdate ไม่สำเร็จ' }));\n\nconst crypto = require('crypto');\nconst body = JSON.stringify({ results });\nconst ts = Math.floor(Date.now() / 1000);\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.INTERNAL_HMAC_SECRET).update(`${body}.${ts}`).digest('hex');\nreturn [{ json: { body, headers: { 'content-type': 'application/json', 'x-signature': signature, 'x-timestamp': String(ts) } } }];"
      },
      "id": "collect-+-sign-ack",
      "name": "Collect + Sign Ack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE}}/api/internal/sheets/ack",
        "options": {
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.body}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "={{$json.headers['content-type']}}"
            },
            {
              "name": "x-signature",
              "value": "={{$json.headers['x-signature']}}"
            },
            {
              "name": "x-timestamp",
              "value": "={{$json.headers['x-timestamp']}}"
            }
          ]
        }
      },
      "id": "ack-sync",
      "name": "Ack Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
