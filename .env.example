# ─── MongoDB ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=line_crm
# network compression ระหว่าง app ↔ Atlas (zstd ดีสุด, zlib เป็น fallback ที่มีใน Node เสมอ)
MONGODB_COMPRESSORS=zstd,zlib
# WiredTiger block compressor ตอนสร้าง collection — zstd | snappy | zlib | none
# หมายเหตุ: Atlas shared tier (M0/M2/M5) อาจไม่อนุญาต สคริปต์จะ fallback ให้เอง
MONGODB_BLOCK_COMPRESSOR=zstd

# ─── AI mirror (S9) ─────────────────────────────────────────────────────
# ใช้ hash เฉพาะข้อมูล scrubbed ใน line_crm_ai เท่านั้น ต้องแยกจาก secret อื่น
# openssl rand -base64 48
AI_HASH_PEPPER=

# ─── LINE — Messaging API channel ───────────────────────────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=

# ─── LINE — Login channel (คนละอันกับข้างบน) ────────────────────────────
LINE_LOGIN_CHANNEL_ID=
# ยื่นขอ Email permission แล้ว (D18) — ถ้ายังไม่อนุมัติให้ตัด email ออก
LINE_LOGIN_SCOPES=openid profile email
NEXT_PUBLIC_LIFF_ID=

# ─── Security ───────────────────────────────────────────────────────────
# openssl rand -base64 48
SESSION_JWT_SECRET=
INTERNAL_HMAC_SECRET=
ALLOWED_LIFF_ORIGINS=https://your-project.vercel.app

# ─── n8n (docs/07) ──────────────────────────────────────────────────────
# dev = false (pull mode, ไม่ต้อง host n8n ออก public) / prod = true
N8N_PUSH_ENABLED=false
N8N_WEBHOOK_LINE=
N8N_WEBHOOK_FORM=
# ใช้กับ docker-compose.yml สำหรับ n8n local
N8N_USER=admin
N8N_PASSWORD=
# openssl rand -base64 32
N8N_ENCRYPTION_KEY=
API_BASE=http://host.docker.internal:3000

# ─── Google Sheets ──────────────────────────────────────────────────────
GOOGLE_SHEET_ID=
