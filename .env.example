# ─── MongoDB ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=line_crm
# network compression ระหว่าง app ↔ Atlas (zstd ดีสุด, zlib เป็น fallback ที่มีใน Node เสมอ)
MONGODB_COMPRESSORS=zstd,zlib
# WiredTiger block compressor ตอนสร้าง collection — zstd | snappy | zlib | none
# หมายเหตุ: Atlas shared tier (M0/M2/M5) อาจไม่อนุญาต สคริปต์จะ fallback ให้เอง
MONGODB_BLOCK_COMPRESSOR=zstd

# ─── AI mirror (S9) ─────────────────────────────────────────────────────
# ใช้ hash เฉพาะข้อมูล scrubbed ใน line_crm_ai เท่านั้น ต้องแยกจาก secret อื่น
# openssl rand -base64 48
AI_HASH_PEPPER=

# Partner intake — JSON map, one independent HMAC secret per partner (min 32 chars)
PARTNER_HMAC_SECRETS_JSON=
# Optional override; defaults to LINE_CHANNEL_ID
PARTNER_LINE_CHANNEL_ID=

# ─── Legacy batch / AI mirror scrub (S11-M2) ─────────────────────────────
# ใช้ URI แยกตามสิทธิ์; ห้ามใช้ MONGODB_URI เป็นตัวเขียน AI DB จากสคริปต์นี้
LEGACY_MONGODB_URI=mongodb://localhost:27018/?directConnection=true
LEGACY_MONGODB_DB=line_crm_legacy
AI_MONGODB_DB=line_crm_ai
# หน้า /admin/review ใช้ review_user: อ่าน AI/legacy และแก้เฉพาะ customer_links
ADMIN_MONGODB_URI=mongodb://localhost:27018/?directConnection=true

# S11-M3 — optional; ไม่ตั้งค่าแล้ว deterministic matching ยังทำงานได้ครบ
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
# เปิดได้เฉพาะเมื่อมี decision ใหม่อนุญาต PII; ค่าเริ่มต้นต้องเป็น false
LLM_ALLOW_NAME_PAIRS=false

# ─── LINE — Messaging API channel ───────────────────────────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=

# ─── LINE — Login channel (คนละอันกับข้างบน) ────────────────────────────
LINE_LOGIN_CHANNEL_ID=
# ยื่นขอ Email permission แล้ว (D18) — ถ้ายังไม่อนุมัติให้ตัด email ออก
LINE_LOGIN_SCOPES=openid profile email
NEXT_PUBLIC_LIFF_ID=

# ─── Security ───────────────────────────────────────────────────────────
# openssl rand -base64 48
SESSION_JWT_SECRET=
INTERNAL_HMAC_SECRET=
ALLOWED_LIFF_ORIGINS=https://your-project.vercel.app

# ─── Staff admin (Google OAuth) ─────────────────────────────────────────
# Callback: https://<domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# openssl rand -base64 48
AUTH_SECRET=
STAFF_EMAIL_ALLOWLIST=staff@example.com,owner@example.com

# ─── ตรวจข้อมูลค้าง (ไม่ตั้งจะใช้ค่าเริ่มต้นเหล่านี้) ───────────────────
STATUS_QUEUE_STALE_MINUTES=15
STATUS_SHEET_STALE_MINUTES=30
STATUS_AI_STALE_MINUTES=30
STATUS_ERROR_WINDOW_MINUTES=15
STATUS_ERROR_SPIKE_COUNT=10

# ─── n8n (docs/07) ──────────────────────────────────────────────────────
# dev = false (pull mode, ไม่ต้อง host n8n ออก public) / prod = true
N8N_PUSH_ENABLED=false
N8N_WEBHOOK_LINE=
N8N_WEBHOOK_FORM=
# ใช้กับ docker-compose.yml สำหรับ n8n local
N8N_USER=admin
N8N_PASSWORD=
# openssl rand -base64 32
N8N_ENCRYPTION_KEY=
API_BASE=http://host.docker.internal:3000

# ─── Google Sheets ──────────────────────────────────────────────────────
GOOGLE_SHEET_ID=

# ─── ส่งต่อแชทให้ระบบ tag (docs/26 §D) ──────────────────────────────────
# LINE ตั้ง webhook ได้ channel ละ 1 อัน ระบบ tag จึงต้องรับต่อจากที่นี่
# ไม่ตั้ง = ไม่ส่งต่อ ระบบทำงานปกติทุกอย่าง
# ปลายทางต้องใช้ LINE_CHANNEL_SECRET ตัวเดียวกันเพื่อตรวจลายเซ็นที่ส่งต่อไป
TAGGER_FORWARD_URL=
